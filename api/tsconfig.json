{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "..",
    "outDir": "build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "lib/**/*.ts",
    "models/**/*.ts",
    "types/**/*.d.ts"
  ]
}