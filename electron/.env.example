# OB Launcher - Environment Variables
# Copy this to .env and fill in your values

# Required for publishing updates to API
API_TOKEN=your_api_token_here

# API Base URL (optional, defaults to https://api.ob1.store)
API_BASE=https://api.ob1.store

# GitHub Token for creating tags (optional, uses git config if not set)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# For development: force update check on dev server
# FORCE_DEV_UPDATE=true